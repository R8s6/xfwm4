+int
+clientGetExternalResizeHandle (Client *c, Window w)
+{
+    int i;
+
+    for (i = 0; i < EXTERNAL_RESIZE_HANDLE_COUNT; i++)
+    {
+        if (MYWINDOW_XWINDOW (c->external_resize[i]) == w)
+        {
+            return clientExternalResizePartForIndex (i);
+        }
+    }
+
+    return NO_HANDLE;
+}
