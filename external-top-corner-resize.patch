+int
+clientGetExternalResizeHandle (Client *c, Window w)
+{
+    if ((MYWINDOW_XWINDOW (c->external_resize[EXTERNAL_RESIZE_TOP_LEFT_HORIZONTAL]) == w) ||
+        (MYWINDOW_XWINDOW (c->external_resize[EXTERNAL_RESIZE_TOP_LEFT_VERTICAL]) == w))
+    {
+        return CORNER_TOP_LEFT;
+    }
+
+    if ((MYWINDOW_XWINDOW (c->external_resize[EXTERNAL_RESIZE_TOP_RIGHT_HORIZONTAL]) == w) ||
+        (MYWINDOW_XWINDOW (c->external_resize[EXTERNAL_RESIZE_TOP_RIGHT_VERTICAL]) == w))
+    {
+        return CORNER_TOP_RIGHT;
+    }
+
+    return NO_HANDLE;
+}
